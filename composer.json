{
    "name": "vrok/doctrine-addons",
    "type": "library",
    "description": "Doctrine ORM type & helper classes",
    "keywords": ["doctrine", "orm", "dbal", "dql", "postgres", "type", "utc", "slug"],
    "homepage": "https://vrok.de",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "doctrine/dbal": "^4.5.0"
    },
    "require-dev": {
        "ext-intl": "*",
        "doctrine/orm": "^3.5.0|^4.0.x-dev",
        "friendsofphp/php-cs-fixer": "^3.95",
        "gedmo/doctrine-extensions": "^3.18.0",
        "phpstan/phpstan": "^2.3.1",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "phpunit/phpunit": "^13.3",
        "rector/rector": "^2.6",
        "roave/security-advisories": "dev-latest",
        "symfony/cache": "^7.4.0|^8.0.0",
        "symfony/serializer": "^7.4.0|^8.0.0",
        "symfony/translation-contracts": "^3.6.0",
        "symfony/var-exporter": "^7.4.0|^8.0.0",
        "vrok/import-export": "^1.2.0",
        "vrok/symfony-addons": "^4.0.0"
    },
    "conflict": {
        "behat/transliterator": "<1.5",
        "doctrine/orm": "<3.0"
    },
    "suggest": {
        "ext-intl": "For Util\\UmlautTransliterator",
        "symfony/serializer": "For the serialization groups of Entity\\LockableTrait",
        "vrok/import-export": "For the import/export attributes of Entity\\LockableTrait"
    },
    "autoload": {
        "psr-4": {
            "Vrok\\DoctrineAddons\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vrok\\DoctrineAddons\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@phpstan",
            "@test"
        ],
        "cs-check": "php-cs-fixer fix --dry-run --diff -v",
        "cs-fix": "php-cs-fixer fix -v",
        "phpstan": "phpstan analyse",
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml"
    }
}
